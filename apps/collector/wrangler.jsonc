{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = production. Staging lives under env.staging and has no crons:
  // it only runs when triggered manually (C-005, C-013).
  "name": "tidaq-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Workers Paid (C-151): a run uses ~260 requests at most (200 nights + checks + database);
  // the cap stops a runaway loop long before the plan's 10,000.
  "limits": { "subrequests": 1000 },
  "triggers": {
    // 05:00 UTC morning run; 17:00 UTC evening run (off until EVENING_RUN=true, D-13);
    // collect every 2 min all day: queues visitor-requested stays, fetches stay results, prices
    // the night grid when no stay result waits (C-013b, D-39, C-022c1, C-070a), checks Price Drops
    // live first (C-142); 07:55 daily check. Must match CRON_* in src/index.ts.
    "crons": ["0 5 * * *", "0 17 * * *", "*/2 * * * *", "55 7 * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "DAILY_TASK_CAP": "400",
    "MONTHLY_BUDGET_USD": "12",
    "EVENING_RUN": "false",
    // Real stay checks per hotel (C-071a): since D-42 they are the ground truth for the night
    // sums, so 4 per hotel (3 weekends + 1 midweek) let ~85 hotels fit the daily cap.
    "GRID_WEEKENDS": "3",
    "GRID_MIDWEEK": "1",
    // Stay results fetched per collect run (sized for the old free plan's 50 requests per run).
    "COLLECT_BATCH": "30",
    "NIGHT_WINDOW_DAYS": "270",
    // Workers Paid since 16 Oct (B-023, C-151): 200 nights per run, ~90 s at most, so ~400
    // hotels × 270 nights get priced every day.
    "NIGHT_BATCH": "200",
    // Free price source (D-41); `dataforseo` switches back to the paid API (needs balance).
    "PRICE_SOURCE": "xotelo",
    // Exact quotes for Price Drops (C-148, D-52): Google Hotels via DataForSEO, $0.0008 a task.
    // 16 Oct: lean budget (Zaid): ~80 quotes a day keep the biggest drops fresh, ~$2 a month.
    "DROP_QUOTE_DAILY_CAP": "80",
    "DROP_QUOTE_MONTHLY_USD": "3",
    // Operations emails (failed runs, 80 % budget, daily check). Comma-separated (CLAUDE.md §7).
    "ADMIN_EMAILS": "zaidghazal216@gmail.com",
    // Stays true until the alert engine (C-031) is tested end to end.
    "ALERTS_DRY_RUN": "true",
  },
  "env": {
    "staging": {
      "name": "tidaq-collector-staging",
      "triggers": { "crons": [] },
      "vars": {
        "APP_ENV": "staging",
        "DAILY_TASK_CAP": "50",
        "MONTHLY_BUDGET_USD": "12",
        "EVENING_RUN": "false",
        "GRID_WEEKENDS": "6",
        "GRID_MIDWEEK": "2",
        "COLLECT_BATCH": "30",
        "NIGHT_WINDOW_DAYS": "270",
        "NIGHT_BATCH": "40",
        "PRICE_SOURCE": "xotelo",
        "ADMIN_EMAILS": "zaidghazal216@gmail.com",
        "ALERTS_DRY_RUN": "true",
      },
    },
  },
}
