{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = production. Staging lives under env.staging and has no crons:
  // it only runs when triggered manually (C-005, C-013).
  "name": "tidaq-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "triggers": {
    // 05:00 UTC morning run; 17:00 UTC evening run (off until EVENING_RUN=true, D-13);
    // collect every 2 min all day: queues visitor-requested stays, fetches stay results, prices
    // the night grid when no stay result waits (C-013b, D-39, C-022c1, C-070a); 07:55 daily check.
    // Free plan: 5 cron triggers per account, 4 used.
    // Must match CRON_* in src/index.ts.
    "crons": ["0 5 * * *", "0 17 * * *", "*/2 * * * *", "55 7 * * *"],
  },
  "vars": {
    "APP_ENV": "production",
    "DAILY_TASK_CAP": "400",
    "MONTHLY_BUDGET_USD": "12",
    "EVENING_RUN": "false",
    "GRID_WEEKENDS": "6",
    "GRID_MIDWEEK": "2",
    // Results fetched per collect run; the Workers free plan allows 50 subrequests per run.
    "COLLECT_BATCH": "30",
    "NIGHT_WINDOW_DAYS": "120",
    "NIGHT_BATCH": "36",
    // Free price source (D-41); `dataforseo` switches back to the paid API (needs balance).
    "PRICE_SOURCE": "xotelo",
    // Operations emails (failed runs, 80 % budget, daily check). Comma-separated (CLAUDE.md §7).
    "ADMIN_EMAILS": "zaidghazal216@gmail.com",
    // Stays true until the alert engine (C-031) is tested end to end.
    "ALERTS_DRY_RUN": "true",
  },
  "env": {
    "staging": {
      "name": "tidaq-collector-staging",
      "triggers": { "crons": [] },
      "vars": {
        "APP_ENV": "staging",
        "DAILY_TASK_CAP": "50",
        "MONTHLY_BUDGET_USD": "12",
        "EVENING_RUN": "false",
        "GRID_WEEKENDS": "6",
        "GRID_MIDWEEK": "2",
        "COLLECT_BATCH": "30",
        "NIGHT_WINDOW_DAYS": "120",
        "NIGHT_BATCH": "36",
        "PRICE_SOURCE": "xotelo",
        "ADMIN_EMAILS": "zaidghazal216@gmail.com",
        "ALERTS_DRY_RUN": "true",
      },
    },
  },
}
