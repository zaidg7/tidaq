{
  "name": "tidaq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "pnpm -r --parallel lint && prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm --filter web e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
